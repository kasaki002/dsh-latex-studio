{
  "name": "@kasaki002/dsh-latex-studio",
  "version": "0.4.0",
  "description": "LaTeX 工作室：便携 MiKTeX（xelatex / pdflatex）+ 网页编辑器 + 编译工具",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "latex",
    "miktex",
    "xelatex",
    "pdflatex",
    "typesetting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasaki002/dsh-latex-studio.git"
  },
  "homepage": "https://github.com/kasaki002/dsh-latex-studio#readme",
  "bugs": {
    "url": "https://github.com/kasaki002/dsh-latex-studio/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "INTRO.zh.md",
    "INTRO.en.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
